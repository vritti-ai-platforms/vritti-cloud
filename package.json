{
  "name": "vritti-cloud",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "nx run-many --target=dev --projects=vritti-cloud-server,vritti-cloud-web --parallel --output-style=stream",
    "dev:prod": "nx run-many --target=dev:prod --projects=vritti-cloud-server,vritti-cloud-web --parallel --output-style=stream",
    "dev:vm": "nx run vritti-cloud-server:dev & nx run vritti-cloud-web:dev:vm",
    "dev:web": "nx run vritti-cloud-web:dev",
    "dev:web:prod": "nx run vritti-cloud-web:dev:prod",
    "build": "nx run-many --target=build --all",
    "lint": "nx run-many --target=lint --all",
    "test": "nx run-many --target=test --all",
    "test:e2e": "nx run-many --target=e2e --all",
    "check": "nx run-many --target=check --all",
    "graph": "nx graph",
    "release": "nx release",
    "db:generate": "nx run vritti-cloud-server:db:generate",
    "db:migrate": "nx run vritti-cloud-server:db:migrate",
    "db:migrate:prod": "nx run vritti-cloud-server:db:migrate:prod",
    "db:studio": "nx run vritti-cloud-server:db:studio",
    "db:studio:prod": "nx run vritti-cloud-server:db:studio:prod",
    "db:start": "nx run vritti-cloud-server:db:start",
    "db:stop": "nx run vritti-cloud-server:db:stop",
    "db:tunnel": "nx run vritti-cloud-server:db:tunnel",
    "db:tunnel:stop": "nx run vritti-cloud-server:db:tunnel:stop"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.2",
    "@nx/js": "^20.8.4",
    "nx": "^20.0.0"
  }
}
